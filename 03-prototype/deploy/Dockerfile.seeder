# The telemetry seeder, as a long-running Cloud Run Job.
#
# Until now this ran on a laptop, which means the hosted demo was one closed terminal away
# from a farm with no telemetry, and judging happens days after submission, at an hour
# nobody chooses. A judge who arrives to an empty stack sees a broken submission, however
# good the agent is.
FROM python:3.11-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends tini \
 && rm -rf /var/lib/apt/lists/* \
 && test -x /usr/bin/tini

WORKDIR /srv
COPY deploy/requirements-seeder.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
COPY telemetry ./
# The scenario also emits telemetry for the studio slate, which is generated by
# second_unit.shots_catalog. Without this COPY the import fails inside the container and the
# seeder degrades to the three incident shots, working perfectly on a laptop and quietly
# missing 60 shots in production. The assertion below turns that into a build failure.
COPY agent/second_unit ./second_unit
RUN test -f /srv/seed.py && test -f /srv/scenario.py && test -f /srv/push.py \
 && test -f /srv/second_unit/shots_catalog.py \
 && python -c "import cramjam, requests; print('deps ok')" \
 && python -c "import sys; sys.path.insert(0,'/srv'); from second_unit.shots_catalog import active; print('catalogue ok:', len(active()), 'active')"

ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1

# --loop is the whole point: fault, cascade, repair, restart, forever, so there is always a
# live incident in range. --start-minute -25 gives a healthy baseline before the first fault
# so the forecaster has something to compare against.
ENTRYPOINT ["/usr/bin/tini", "--", "python", "seed.py", "--live", "--loop", "--start-minute", "-25"]
