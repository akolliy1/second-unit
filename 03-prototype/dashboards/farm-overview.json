{
  "uid": "second-unit-farm-vancouver",
  "title": "Render Farm. Vancouver",
  "description": "Pipeline TD's daily driver for the Vancouver render farm: throughput, per-node health, queue pressure and failure reasons, with the scheduler log alongside. Baseline dashboard, hand-built for the Second Unit prototype.",
  "tags": [
    "second-unit",
    "render-farm",
    "vancouver"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 0,
  "refresh": "1m",
  "graphTooltip": 1,
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "30s",
      "1m",
      "5m",
      "15m",
      "1h"
    ]
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
