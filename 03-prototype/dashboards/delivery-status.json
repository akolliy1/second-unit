{
  "uid": "second-unit-delivery-status",
  "title": "Delivery Status. Current Shots",
  "description": "Producer's view of the three shots in flight: what is left, how fast it is moving, when it lands, and where frame time is going. Baseline dashboard, hand-built for the Second Unit prototype.",
  "tags": [
    "second-unit",
    "delivery",
    "production"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 0,
  "refresh": "1m",
  "graphTooltip": 1,
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "30s",
      "1m",
      "5m",
      "15m",
      "1h"
    ]
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Frames remaining",
      "description": "Frames still to render for each shot in flight.",
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [],
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "percentChangeColorMode": "standard"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "expr": "sum by (shot) (shot_frames_remaining{farm=\"vancouver\"})",
          "legendFormat": "{{shot}}",
          "editorMode": "code",
          "range": true,
          "instant": false
        }
      ]
    },
