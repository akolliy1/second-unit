# ---- copy to .env (in THIS directory) and fill in. .env is gitignored. ----
# One file serves both 03-prototype/spike/ and 03-prototype/telemetry/: python-dotenv
# walks up from the working directory, so either script finds it.
# NEVER commit the real one. In production these move to Secret Manager.

# --- Google Cloud / Vertex AI ---
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-flash-latest

# --- Grafana Cloud stack (Rung 1 + 2) ---
# Stack > Administration > Users and access > Service accounts > Add service account.
# Role Admin: Editor cannot create alert rules, and write-back is the demo's payoff.
GRAFANA_URL=https://your-stack.grafana.net
GRAFANA_SERVICE_ACCOUNT_TOKEN=glsa_xxxxxxxxxxxxxxxx

# --- Grafana Cloud hosted MCP (the PRIMARY path, architecture 0.1) ---
GRAFANA_CLOUD_MCP_URL=https://mcp.grafana.com/mcp

# --- Local mcp-grafana bridge (fallback only; started by spike/start_grafana_mcp.sh) ---
MCP_GRAFANA_URL=http://localhost:8000/mcp
# Shared secret the bridge requires from callers. Any random string.
MCP_GRAFANA_SERVER_TOKEN=pick-a-random-string-here

# --- Telemetry seeding (telemetry/seed.py) ---
# grafana.com > your stack > Prometheus "Send Metrics" / Details, and Loki "Send Logs".
# The username is the numeric instance ID; the password is one cloud access policy
# token (glc_...) that works for both.
PROM_REMOTE_WRITE_URL=https://prometheus-prod-XX-prod-YY-ZZ.grafana.net/api/prom/push
PROM_USER=1234567
LOKI_PUSH_URL=https://logs-prod-XX.grafana.net
LOKI_USER=1234567
GRAFANA_CLOUD_TOKEN=glc_xxxxxxxxxxxxxxxx

# --- Grafana Cloud AI Observability (agent traces) ---
# The access policy needs traces:write in addition to metrics:write and logs:write.
# OTLP_USER is the STACK id, not the Prometheus/Loki user id: those return 401.
# The endpoint is derived from PROM_REMOTE_WRITE_URL unless you set OTLP_ENDPOINT.
OTLP_USER=1234567

# --- Fallback track only (ClickHouse). Leave blank unless Grafana fails. ---
CLICKHOUSE_HOST=
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_SECURE=true
